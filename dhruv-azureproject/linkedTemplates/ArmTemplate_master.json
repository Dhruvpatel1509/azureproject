{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dhruv-azureproject"
		},
		"AzureDataLakeStoragelinkedservice_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStoragelinkedservice'"
		},
		"AzureSqlDatabaselinkedservice_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaselinkedservice'"
		},
		"AzureDataLakeStoragelinkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dhruvstorageazureproject.dfs.core.windows.net/"
		},
		"AzureSqlDatabaselinkedservice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dhruvazureprojectserver.database.windows.net"
		},
		"AzureSqlDatabaselinkedservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azureprojectdbdhruv"
		},
		"AzureSqlDatabaselinkedservice_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dhruvpateladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dhruv-azureproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStoragelinkedservice_accountKey": {
						"value": "[parameters('AzureDataLakeStoragelinkedservice_accountKey')]"
					},
					"AzureSqlDatabaselinkedservice_password": {
						"value": "[parameters('AzureSqlDatabaselinkedservice_password')]"
					},
					"AzureDataLakeStoragelinkedservice_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStoragelinkedservice_properties_typeProperties_url')]"
					},
					"AzureSqlDatabaselinkedservice_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaselinkedservice_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaselinkedservice_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaselinkedservice_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaselinkedservice_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaselinkedservice_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}